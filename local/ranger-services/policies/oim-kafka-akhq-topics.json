{
  "service": "oim-kafka",
  "policy": "all - topic",
  "_why": "Keycloak platform 그룹의 관리 화면이다. 사용자별 범위는 AKHQ 가 자기 역할로 다시 좁힌다(edge-reader 는 edge.* 읽기만) - 리소스가 * 라 기본 정책(all - topic)에 항목으로 보탠다(같은 리소스에 정책을 둘 둘 수 없다, Ranger 3010 · Gotcha 201)",
  "item": {
    "users": [
      "akhq"
    ],
    "groups": [],
    "accesses": [
      {
        "type": "publish",
        "isAllowed": true
      },
      {
        "type": "consume",
        "isAllowed": true
      },
      {
        "type": "describe",
        "isAllowed": true
      },
      {
        "type": "create",
        "isAllowed": true
      },
      {
        "type": "delete",
        "isAllowed": true
      },
      {
        "type": "configure",
        "isAllowed": true
      },
      {
        "type": "describe_configs",
        "isAllowed": true
      },
      {
        "type": "alter_configs",
        "isAllowed": true
      },
      {
        "type": "alter",
        "isAllowed": true
      }
    ]
  }
}
