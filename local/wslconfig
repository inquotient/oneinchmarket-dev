# → C:\Users\<user>\.wslconfig 로 복사할 것
# OneinchMarket v2 로컬 k3s 호스트
# 호스트 기준: 63.4 GB RAM / 24 코어. 자세한 산정은 docs/LOCAL-DEPLOYMENT.md

# ★★ `networkingMode=mirrored` 를 넣지 말 것 — 이 호스트에서 클러스터가
#   통째로 무너진다(§8-77, Gotcha 49). Windows 의 Up 어댑터 6개가 전부
#   미러링되고, k3s 가 --node-ip 미설정이라 Hyper-V L0 랩 주소를 노드 IP 로
#   골라 apiserver 가 kubelet 에 닿지 못한다 → Cilium·CoreDNS·Kyverno 연쇄 붕괴.
[wsl2]
# ★ 48GB → 56GB (2026-09-02, 5단계 착수)
#   4단계 종료 시점에 노드 메모리 limits 가 94~98% 였다. 5단계는
#   ZooKeeper + Hadoop 4종 + HBase 2종 + Hive Server 로 대부분 JVM 이라
#   최소 6~8 GiB 가 더 필요하다. 실사용 상위(GitLab 2987Mi · Logstash
#   1835Mi · ES 1695Mi)는 전부 실제로 쓰는 값이라 더 깎을 여지가 없었다.
#
# ★★ 그 56GB 는 2026-09-05 에 한 번 **실패했다** — 그때는 Hyper-V L0 랩
#   (OPNsense 6.0 + Target 2.2 = 8.4 GiB)이 함께 돌고 있어서 Windows 가
#   먼저 무너졌다. 그래서 한동안 44GB 로 내려 두었다.
#
#   2026-09-10 에 다시 56GB 로 올려 **성립했다.** 통한 이유는 상한이 아니라
#   **랩이 꺼져 있었다는 것**이다(§23-3: 랩을 끈 WSL2 의 allocatable 52.62 는
#   랩을 유지한 베어메탈 ~50.7 보다 크다).
#
#   ▸ 전제  : L0 랩이 꺼져 있을 것. 랩을 다시 켜면 **48GB 로 내릴 것.**
#   ▸ 대가  : 호스트 커밋이 79.5 GiB 로 물리 63.4 를 넘어 Windows 가
#             페이징한다. 데스크톱 반응성과 클러스터 용량의 교환이다.
#   ▸ 산수  : allocatable = 상한 - 2.29 GiB (kubelet 예약은 비율이 아니라
#             **고정값**이다 — Gotcha 104). 목표 allocatable + 2.29 를 넣으면 된다.
#   ▸ 판정  : wsl.exe -- free -g 의 MemTotal 과
#             kubectl get node -o jsonpath={.items[0].status.allocatable.memory}
memory=56GB

# ★ 20 → 24 (2026-09-02)
#   CPU requests 가 73% 였다. 호스트 전량을 준다 —
#   WSL2 는 호스트 커널을 공유해 Windows 쪽 스케줄이 굶지 않는다.
processors=24

# zram 이 넘칠 때의 폴백. 압축률이 2.0 아래로 떨어지면 여기로 흘러간다.
# 느리지만 OOM 보다 낫다. zram 은 priority 100, 이쪽은 -2.
# (레포 사본이 16GB 로 적혀 있었으나 실제 호스트는 8GB 였다. 실측값에 맞춘다.)
swap=8GB

[experimental]
# ★★ 유휴 타임아웃 — 이것이 없으면 클러스터가 조용히 죽는다.
#   WSL2 는 VM 에 붙은 프로세스가 없으면 기본 60초 뒤 VM 을 내린다.
#   systemd 로 k3s 가 돌고 있어도 마찬가지다. 편집을 Windows 쪽에서 하는
#   동안(매니페스트 작성 등) WSL 을 건드리지 않으면 VM 이 poweroff 되고,
#   다음 wsl 명령에 새로 부팅되면서 **40개 파드가 전부 재시작**한다.
#   실제로 겪었다 — 부팅 이력에 9분짜리 세션이 남았고 hive-metastore 는
#   재시작이 35회까지 올라갔다. 노드 이벤트에는 압박이 없어 원인이
#   드러나지 않는다(Windows 여유 45GB, MemoryPressure=False).
#   24시간으로 둔다.
vmIdleTimeout=86400000
# ★ 필수 — kubelet 은 기동 시점 총 메모리로 자원을 계산한다.
#   메모리 회수가 일어나면 예측 불가한 OOMKill·축출이 발생한다.
autoMemoryReclaim=disabled
sparseVhd=true
