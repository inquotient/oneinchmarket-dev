{
  "type": "record",
  "name": "MultiLanguageChanged",
  "namespace": "oneinchmarket.commonapi.domain.event",
  "doc": "다국어 항목이 등록·변경될 때 dev.api.cmmn.multilanguage-refresh 토픽으로 나가는 이벤트. 실측에서 얻은 정의다(§8-99) — 앱이 게시에 실패하며 남긴 예외에 직렬화기가 찍은 스키마 전문이 들어 있었다. 파일명이 곧 ccompat subject 이므로 바꾸지 말 것.",
  "fields": [
    { "name": "multiLanguageNo", "type": ["null", "long"], "default": null },
    { "name": "multiLanguageId", "type": ["null", { "type": "string", "avro.java.string": "String" }], "default": null },
    { "name": "multiLanguageUsageType", "type": ["null", { "type": "string", "avro.java.string": "String" }], "default": null },
    { "name": "multiLanguageType", "type": ["null", { "type": "string", "avro.java.string": "String" }], "default": null },
    { "name": "multiLanguage", "type": ["null", { "type": "string", "avro.java.string": "String" }], "default": null },
    { "name": "multiLanguageDescription", "type": ["null", { "type": "string", "avro.java.string": "String" }], "default": null },
    { "name": "multiLanguageEventType", "type": ["null", { "type": "string", "avro.java.string": "String" }], "default": null },
    {
      "name": "commonData",
      "type": [
        "null",
        {
          "type": "record",
          "name": "CommonData",
          "doc": "감사 필드. REST 계약의 components.schemas.CommonFields 와 같은 개념이다.",
          "fields": [
            { "name": "enabled", "type": ["null", "boolean"], "default": null },
            { "name": "deleted", "type": ["null", "boolean"], "default": null },
            { "name": "creatorNo", "type": ["null", "long"], "default": null },
            { "name": "createdAt", "type": ["null", { "type": "long", "logicalType": "local-timestamp-millis" }], "default": null },
            { "name": "modifierNo", "type": ["null", "long"], "default": null },
            { "name": "modifiedAt", "type": ["null", { "type": "long", "logicalType": "local-timestamp-millis" }], "default": null }
          ]
        }
      ],
      "default": null
    }
  ]
}
