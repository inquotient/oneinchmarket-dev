   "dataMaskDef": {
    "maskTypes": [
     {
      "description": "Replace lowercase with 'x', uppercase with 'X', digits with '0'",
      "itemId": 3004,
      "label": "Redact",
      "name": "hive:MASK",
      "transformer": "mask({col})"
     },
     {
      "description": "Show last 4 characters; replace rest with 'x'",
      "itemId": 3005,
      "label": "Partial mask: show last 4",
      "name": "hive:MASK_SHOW_LAST_4",
      "transformer": "mask_show_last_n({col}, 4, 'x', 'x', 'x', -1, '1')"
     },
     {
      "description": "Show first 4 characters; replace rest with 'x'",
      "itemId": 3006,
      "label": "Partial mask: show first 4",
      "name": "hive:MASK_SHOW_FIRST_4",
      "transformer": "mask_show_first_n({col}, 4, 'x', 'x', 'x', -1, '1')"
     },
     {
      "description": "Hash the value",
      "itemId": 3007,
      "label": "Hash",
      "name": "hive:MASK_HASH",
      "transformer": "mask_hash({col})"
     },
     {
      "description": "Replace with NULL",
      "itemId": 3008,
      "label": "Nullify",
      "name": "hive:MASK_NULL"
     },
     {
      "description": "No masking",
      "itemId": 3009,
      "label": "Unmasked (retain original value)",
      "name": "hive:MASK_NONE"
     },
     {
      "description": "Date: show only year",
      "itemId": 3015,
      "label": "Date: show only year",
      "name": "hive:MASK_DATE_SHOW_YEAR",
      "transformer": "mask({col}, 'x', 'x', 'x', -1, '1', 1, 0, -1)"
     },
     {
      "description": "Custom",
      "itemId": 3016,
      "label": "Custom",
      "name": "hive:CUSTOM"
     },
     {
      "description": "Replace lowercase with 'x', uppercase with 'X', digits with '0'",
      "itemId": 203204,
      "label": "Redact",
      "name": "trino:MASK",
      "transformer": "cast(regexp_replace(regexp_replace(regexp_replace({col},'([A-Z])', 'X'),'([a-z])','x'),'([0-9])','0') as {type})"
     },
     {
      "description": "Show last 4 characters; replace rest with 'X'",
      "itemId": 203205,
      "label": "Partial mask: show last 4",
      "name": "trino:MASK_SHOW_LAST_4",
      "transformer": "cast(regexp_replace({col}, '(.*)(.{4}$)', x -> regexp_replace(x[1], '.', 'X') || x[2]) as {type})"
     },
     {
      "description": "Show first 4 characters; replace rest with 'x'",
      "itemId": 203206,
      "label": "Partial mask: show first 4",
      "name": "trino:MASK_SHOW_FIRST_4",
      "transformer": "cast(regexp_replace({col}, '(^.{4})(.*)', x -> x[1] || regexp_replace(x[2], '.', 'X')) as {type})"
     },
     {
      "description": "Hash the value of a varchar with sha256",
      "itemId": 203207,
      "label": "Hash",
      "name": "trino:MASK_HASH",
      "transformer": "cast(to_hex(sha256(to_utf8({col}))) as {type})"
     },
     {
      "description": "Replace with NULL",
      "itemId": 203208,
      "label": "Nullify",
      "name": "trino:MASK_NULL"
     },
     {
      "description": "No masking",
      "itemId": 203209,
      "label": "Unmasked (retain original value)",
      "name": "trino:MASK_NONE"
     },
     {
      "description": "Date: show only year",
      "itemId": 203215,
      "label": "Date: show only year",
      "name": "trino:MASK_DATE_SHOW_YEAR",
      "transformer": "date_trunc('year', {col})"
     },
     {
      "description": "Custom",
      "itemId": 203216,
      "label": "Custom",
      "name": "trino:CUSTOM"
     },
     {
      "description": "Replace lowercase with 'x', uppercase with 'X', digits with '0'",
      "itemId": 17018,
      "label": "Redact",
      "name": "presto:MASK",
      "transformer": "cast(regexp_replace(regexp_replace(regexp_replace({col},'([A-Z])', 'X'),'([a-z])','x'),'([0-9])','0') as {type})"
     },
     {
      "description": "Show last 4 characters; replace rest with 'X'",
      "itemId": 17019,
      "label": "Partial mask: show last 4",
      "name": "presto:MASK_SHOW_LAST_4",
      "transformer": "cast(regexp_replace({col}, '(.*)(.{4}$)', x -> regexp_replace(x[1], '.', 'X') || x[2]) as {type})"
     },
     {
      "description": "Show first 4 characters; replace rest with 'x'",
      "itemId": 17020,
      "label": "Partial mask: show first 4",
      "name": "presto:MASK_SHOW_FIRST_4",
      "transformer": "cast(regexp_replace({col}, '(^.{4})(.*)', x -> x[1] || regexp_replace(x[2], '.', 'X')) as {type})"
     },
     {
      "description": "Hash the value of a varchar with sha256",
      "itemId": 17021,
      "label": "Hash",
      "name": "presto:MASK_HASH",
      "transformer": "cast(to_hex(sha256(to_utf8({col}))) as {type})"
     },
     {
      "description": "Replace with NULL",
      "itemId": 17022,
      "label": "Nullify",
      "name": "presto:MASK_NULL"
     },
     {
      "description": "No masking",
      "itemId": 17023,
      "label": "Unmasked (retain original value)",
      "name": "presto:MASK_NONE"
     },
     {
      "description": "Date: show only year",
      "itemId": 17029,
      "label": "Date: show only year",
      "name": "presto:MASK_DATE_SHOW_YEAR",
      "transformer": "date_trunc('year', {col})"
     },
     {
      "description": "Custom",
      "itemId": 17030,
