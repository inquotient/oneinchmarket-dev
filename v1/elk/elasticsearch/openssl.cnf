[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = req_ext

[ dn ]
CN = elasticsearch-es-http.dev.es.local

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = elasticsearch-es-http.dev.svc.cluster.local
DNS.2 = elasticsearch-es-all.dev.svc.cluster.local
DNS.3 = elasticsearch-es-internal-http.dev.svc.cluster.local
DNS.4 = elasticsearch-es-transport.dev.svc.cluster.local